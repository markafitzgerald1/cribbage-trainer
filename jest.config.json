{
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/game/parseCards.common.ts",
    "!src/ui/discardQualityTrend.test.common.ts",
    "!src/ui/discardTally.test.common.ts",
    "!src/ui-react/DecisionQualityTrendDialog.test.common.ts",
    "!src/ui-react/MistakeQueueDialog.test.common.ts",
    "!src/ui-react/PracticeDrillPanel.test.common.ts",
    "!src/ui-react/handToSortedString.test.common.ts",
    "!src/ui-react/discardTally.test.common.ts",
    "!src/ui-react/Trainer.test.common.tsx",
    "!src/ui-react/useDiscardTally.test.common.ts",
    "!src/ui-react/useDiscardTelemetry.test.common.ts",
    "!src/ui-react/useDiscardTelemetryConsentTiming.test.common.tsx",
    "!src/ui-react/*.stories.{ts,tsx}",
    "!src/ui-react/stories.common.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 100,
      "functions": 100,
      "lines": 100,
      "statements": 100
    }
  },
  "moduleNameMapper": {
    "\\.module\\.css$": "<rootDir>/__mocks__/styleMock.ts"
  },
  "testEnvironment": "jsdom",
  "testPathIgnorePatterns": [
    "/.claude/",
    "/scripts/",
    "/tests-e2e/",
    "/tests-examples"
  ],
  "transform": {
    "^.+\\.tsx?$": "babel-jest"
  }
}
